# Single-page-app routes. Vite copies this file into dist/client, so the rules
# ship with the publish directory itself and keep working on deploys that are
# not built from netlify.toml (for example a drag-and-drop of dist/client).
# /api/* is deliberately absent: those requests must reach the server entry.
/ebooks        /index.html   200
/ebooks/*      /index.html   200
/checkout/*    /index.html   200
/order/*       /index.html   200
/resell        /index.html   200
/resell/*      /index.html   200
/track         /index.html   200
/support       /index.html   200
/request       /index.html   200
/refund        /index.html   200
/policies      /index.html   200
/admin         /index.html   200
